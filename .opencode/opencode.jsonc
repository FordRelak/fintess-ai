{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "autoupdate": "notify",
  "enabled_providers": [
    "openai"
  ],
  "model": "openai/gpt-5.6-luna",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "build": {
      "permission": {
        "*": "ask",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.pfx": "deny",
          "*.p12": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          "opencode.json": "deny",
          "opencode.jsonc": "deny",
          "AGENTS.md": "ask",
          ".github/workflows/**": "ask"
        },
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow",
          "git push *": "deny",
          "git reset *": "deny",
          "git clean *": "deny",
          "rm *": "deny",
          "sudo *": "deny",
          "chown *": "deny",
          "openspec *": "allow",
          "dotnet *": "allow",
          "ls": "allow",
          "ls *": "allow",
          "date *": "allow",
          "mkdir *": "allow",
          "mv *": "allow"
        },
        "external_directory": "deny",
        "task": "allow",
        "websearch": "allow",
        "webfetch": "ask",
        "skill": {
          "*": "deny",
          "openspec-*": "allow",
          "analyze-training-progress": "allow",
          "analyze-all-training-scenarios": "allow"
        },
        "question": "allow",
        "doom_loop": "ask",
        "todowrite": "allow"
      }
    }
  }
}