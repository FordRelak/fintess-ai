{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Training Analysis Result",
  "description": "Typed output produced by the training analysis skill from metrics.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observations",
    "hypotheses",
    "recommendations",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "observationId": {
      "type": "string",
      "pattern": "^obs-[a-z0-9][a-z0-9-]*$"
    },
    "hypothesisId": {
      "type": "string",
      "pattern": "^hyp-[a-z0-9][a-z0-9-]*$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "scope",
        "onsetWeek",
        "throughWeek",
        "confidence",
        "evidence",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/observationId"
        },
        "type": {
          "type": "string",
          "enum": [
            "performance_plateau",
            "performance_progression",
            "body_weight_trend",
            "training_consistency",
            "program_target_deviation"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "exercise",
            "program",
            "body_weight"
          ]
        },
        "exerciseId": {
          "type": "string",
          "minLength": 1
        },
        "onsetWeek": {
          "$ref": "#/$defs/week"
        },
        "throughWeek": {
          "$ref": "#/$defs/week"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "exercise"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "exerciseId": {}
            },
            "required": [
              "exerciseId"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "fromWeek",
        "throughWeek",
        "trend"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "enum": [
            "maxWeightKg",
            "totalReps",
            "volumeKg",
            "workingSetCount",
            "effort",
            "bodyWeightAverageKg",
            "workoutCount"
          ]
        },
        "fromWeek": {
          "$ref": "#/$defs/week"
        },
        "throughWeek": {
          "$ref": "#/$defs/week"
        },
        "trend": {
          "type": "string",
          "enum": [
            "increasing",
            "decreasing",
            "stable",
            "fluctuating",
            "consistent"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "confidence",
        "basedOn",
        "reasoning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/hypothesisId"
        },
        "type": {
          "type": "string",
          "enum": [
            "exercise_specific_adaptation",
            "programming_constraint",
            "fatigue_accumulation",
            "recovery_constraint",
            "nutrition_constraint",
            "technique_constraint",
            "insufficient_evidence"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "basedOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/observationId"
          }
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "basedOn",
        "priority",
        "action"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "adjust_progression",
            "modify_volume",
            "modify_intensity",
            "deload",
            "substitute_exercise",
            "maintain_current_plan",
            "review_recovery",
            "review_nutrition",
            "collect_more_data"
          ]
        },
        "exerciseId": {
          "type": "string",
          "minLength": 1
        },
        "basedOn": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(obs|hyp)-[a-z0-9][a-z0-9-]*$"
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "impact"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "missing_recovery_data",
            "missing_nutrition_intake_data",
            "missing_technique_data",
            "missing_pain_or_injury_data",
            "measurement_sparsity",
            "insufficient_history",
            "other"
          ]
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
